# Copy to .env next to docker-compose.prod.yml on the VPS and fill in real values.
# .env is gitignored - it never leaves the server.

# Public hostname the prompter is served on. Must already resolve to this host's IP:
# Caddy uses it both as the vhost name and as the domain it requests a certificate for.
DOMAIN=prompteur.example.com

# Let's Encrypt sends renewal-failure and expiry notices here. Optional, but Caddy warns
# without one.
ACME_EMAIL=admin@example.com
